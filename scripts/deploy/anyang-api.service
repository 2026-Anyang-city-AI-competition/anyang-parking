# 추천 API — systemd 유닛.
#
#   sudo cp scripts/deploy/anyang-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now anyang-api
#
# ★ 유닛 파일에 키를 적지 않는다. `EnvironmentFile` 로만 읽고, 그 파일은 0600 이다.
#   Secret Manager 를 쓰면 scripts/deploy/load_secrets.sh 가 그 파일을 만든다.
# ★ **워커는 1개다.** 모델을 프로세스마다 한 번씩 더 올리게 되고, `parking.db` 에
#   동시에 쓰는 프로세스가 늘어난다. 늘리지 말 것.

[Unit]
Description=Anyang parking recommendation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chabee2027
WorkingDirectory=/home/chabee2027/anyang-parking
EnvironmentFile=/etc/anyang-parking/api.env
Environment=APP_ENV=production
ExecStart=/home/chabee2027/anyang-parking/.venv/bin/python -m uvicorn src.serve.api:app \
    --host 127.0.0.1 --port 8000 --workers 1 --timeout-keep-alive 30

# 재시작 정책 — 죽으면 되살리되, 부팅 루프는 막는다.
Restart=always
RestartSec=5
# 10분 안에 5번 넘게 죽으면 멈추고 사람을 부른다. 무한 재시작으로 원인을 덮지 않는다.
StartLimitIntervalSec=600
StartLimitBurst=5

# 느린 종료로 배포가 막히지 않게 한다.
TimeoutStopSec=30
KillSignal=SIGTERM

# 최소 권한.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/chabee2027/anyang-parking/data /home/chabee2027/anyang-parking/logs

StandardOutput=append:/home/chabee2027/anyang-parking/logs/api.log
StandardError=append:/home/chabee2027/anyang-parking/logs/api.log

[Install]
WantedBy=multi-user.target
