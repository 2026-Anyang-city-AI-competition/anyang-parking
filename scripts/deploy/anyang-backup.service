[Unit]
Description=Back up the Anyang parking SQLite database
After=anyang-poll.service

[Service]
Type=oneshot
User=chabee2027
WorkingDirectory=/home/chabee2027/anyang-parking
Environment=KEEP=7
ExecStart=/home/chabee2027/anyang-parking/scripts/backup_db.sh backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/chabee2027/anyang-parking/data /home/chabee2027/anyang-parking/logs

